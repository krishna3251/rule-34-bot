# ══════════════════════════════════════════
#  NatsuBot — Environment Variables
# ══════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

DISCORD_TOKEN=your_discord_bot_token
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/r34bot
OWNER_IDS=123456789,987654321
R34_USER_ID=your_rule34_user_id
R34_API_KEY=your_rule34_api_key
GELBOORU_API_KEY=your_gelbooru_api_key
GELBOORU_USER_ID=your_gelbooru_user_id
ITCH_API_KEY=optional_itch_api_key
DEBUG_MODE=false
ERROR_WEBHOOK_URL=optional_discord_webhook_for_errors
